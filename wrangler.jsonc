{
  // Gorilla Squad (formerly Thebes): one Worker serves the site and app (public/), the API, tracked links (/s/…) and the games engine pages (/play/…).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gorilla-squad",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*", "/play/*", "/files/*", "/auth/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "thebes", "database_id": "518aab82-fa35-4f59-8734-8d80be609848", "migrations_dir": "db/migrations" }],
  // wrangler r2 bucket create thebes-files
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "thebes-files" }],
  "ai": { "binding": "AI" },
  // No cron: the free plan allows 5 per account. Contests open and close (and winners are picked) when the feed loads
  // or someone plays. On Workers Paid, add  "triggers": { "crons": ["*/5 * * * *"] }  to also do it on a timer.
  "workers_dev": true,
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://gorillasquad.xyz",   // tracked links are built from this (empty: the address the request came in on)
    "EMAIL_MODE": "resend",               // "resend" sends sign-in links (secret RESEND_API_KEY); "show" returns them (local only)
    "EMAIL_FROM": "Gorilla Squad <hello@gorillasquad.xyz>",
    "ADMIN_EMAILS": "",                   // comma-separated: these accounts become admins when they sign in
    "AI_MODE": "live"                     // "live" uses Workers AI to word and colour designs; "off" uses the template defaults
  },
  "env": {
    // npm run dev: everything local (D1, R2 on disk), sign-in links shown on screen, no AI
    "local": {
      "d1_databases": [{ "binding": "DB", "database_name": "thebes", "database_id": "local", "migrations_dir": "db/migrations" }],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "thebes-files" }],
      "vars": { "APP_URL": "http://localhost:8787", "EMAIL_MODE": "show", "EMAIL_FROM": "Thebes <hello@localhost>", "ADMIN_EMAILS": "admin@thebes.local", "AI_MODE": "off" }
    }
  }
}
